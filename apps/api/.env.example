# Copy to apps/api/.env and fill in. Never commit .env. Full walkthrough: docs/SETUP.md

# ---- Required -------------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=8787

# Supabase (Mumbai, ap-south-1): Project Settings > Database > Connection string > "Session pooler" (port 5432).
# Use the password you set when creating the project. Local Postgres works too.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true            # true for Supabase, false for local Postgres

# The web app's address(es), comma separated. Must match exactly, including https and no trailing slash.
WEB_ORIGINS=http://localhost:5173

# Generate all four with:  npm run gen:secrets -w @saathi/api   (paste the output below)
# Losing DATA_KEK makes every stored journal, memory and phone number unreadable. Back it up somewhere safe.
JWT_SECRET=
DATA_KEK=
PHONE_HASH_KEY=
OTP_PEPPER=

# ---- The AI (required for conversations) ---------------------------------------------------------------------
# https://console.anthropic.com > API keys
ANTHROPIC_API_KEY=
# Defaults are fine. Companion = live replies, Safety = classifier on every turn, Analysis = journal/summaries/letter.
# MODEL_COMPANION=claude-sonnet-5-5
# MODEL_SAFETY=claude-haiku-5-5
# OpenRouter (optional): or add the key in the portal, then set Settings > AI provider to OpenRouter.
# OPENROUTER_API_KEY=
# MODEL_ANALYSIS=claude-opus-5-5

# ---- Phone sign-in code (SMS/WhatsApp vendor NOT chosen yet) ------------------------------------------------------
# 'console' (default in development) prints the code in the API log and returns it to the app: development only.
# In production this must stay 'none' until an OtpProvider is implemented (docs/PROVIDERS.md). Until then production
# sign-in by phone is refused, and Google sign-in (below) is the way in.
OTP_PROVIDER=console

# ---- Optional ------------------------------------------------------------------------------------------------
# Google sign-in. Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web). Add your web origin.
GOOGLE_CLIENT_ID=

# Web push notifications. Generate once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Voice and calls (vendors NOT chosen yet; leave as none) -------------------------------------------------------
# With none, the web app uses the browser's own speech recognition and voice, through the same safety pipeline.
STT_PROVIDER=none
TTS_PROVIDER=none
TELEPHONY_PROVIDER=none

# ---- Admin portal (docs/ADMIN.md) ----------------------------------------------------------------------------------
# Origins the admin app is served from (cookies are allowed for these only). Create the first admin with:
#   npm run admin:create -w @saathi/api -- --email you@example.com --name "You"
ADMIN_ORIGINS=http://localhost:5174
ADMIN_SESSION_HOURS=8
# Production: apply migrations at start (or run `npm run db:migrate` as a release step).
# AUTO_MIGRATE=1
# Shown on the Infrastructure and Developer pages (the Docker build and deploy workflow set these).
# APP_VERSION=
# GIT_SHA=
# BUILD_TIME=
# GITHUB_TOKEN=            # or add it on the Integrations page

# Closed beta: phone numbers that can sign in with a fixed six-digit code while no SMS vendor is connected.
# Comma-separated phone:code pairs. Adds them if missing, never overwrites. Prefer People > Add a person in the portal.
# BETA_LOGINS_BOOTSTRAP=9876543210:123456

# ---- Tuning --------------------------------------------------------------------------------------------------
# RUN_WORKER=true runs the scheduler (check-ins, letters, purges) inside the API process. Run exactly one instance
# with it on, or split it out later.
RUN_WORKER=true
BASIC_VOICE_MINUTES_PER_DAY=10
LOG_LEVEL=info
