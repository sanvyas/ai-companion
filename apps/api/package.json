{
  "name": "@saathi/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "gen:secrets": "tsx src/crypto/gen-secrets.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/admin/create-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.1.1",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "11.0.1",
    "@saathi/contracts": "*",
    "@saathi/domain": "*",
    "fastify": "5.1.0",
    "jose": "5.9.6",
    "pg": "8.13.1",
    "web-push": "3.6.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.5.13",
    "axe-core": "^4.10.2",
    "playwright": "^1.63.0",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "ws": "8.18.0"
  }
}
