{
  "name": "saathi",
  "private": true,
  "version": "0.2.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm -w @saathi/web run dev",
    "dev:api": "npm -w @saathi/api run dev",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm -w @saathi/api run db:migrate",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
